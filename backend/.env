# ===== ORDER CREATION =====
# These must be ENABLED in Magento admin (Stores > Configuration > Sales):
#   Shipping Methods > Free Shipping        -> freeshipping / freeshipping
#   Payment Methods  > Check / Money order  -> checkmo
MAGENTO_SHIPPING_CARRIER=freeshipping
MAGENTO_SHIPPING_METHOD=freeshipping
MAGENTO_PAYMENT_METHOD=checkmo

# ===== CUSTOMER ADDRESS PLACEHOLDERS =====
DEFAULT_COUNTRY_ID=IN
DEFAULT_REGION=Tamil Nadu
DEFAULT_CITY=NA
DEFAULT_POSTCODE=000000
# Customers added without an email get  <phone>@this-domain
PLACEHOLDER_EMAIL_DOMAIN=pos-customers.example.com

# Create POS categories + GST attributes in Magento on startup (true/false)
AUTO_SETUP=true
